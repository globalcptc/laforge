{
  // launch.json's own preLaunchTask -- so F5 always launches against a
  // freshly compiled out/extension.js, not whatever happened to be
  // sitting there from the last manual `npm run compile`.
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
