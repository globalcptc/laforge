# Copy this file to .env and fill in your values. .env is gitignored --
# never commit real secrets. Every laforge service reads it: under docker
# compose automatically, or from the repo root when you run a service
# directly (e.g. `go run ./cmd/laforge-api`).
#
# The values below are written for a real deployment on your own domain.
# For a quick local trial with docker compose, see the notes on each
# value (mostly: clear the URLs and leave the agent section empty).
#
# For the full addressing picture -- which URL is reached by browsers vs.
# by deployed hosts -- see the "Addressing" section of USAGE.md.


# ============================================================
# Database
# ============================================================
# Leave this commented out for docker compose -- compose sets the database
# connection for every service itself. Only set it if you run a service
# directly against your own Postgres (the value here is just an example of
# the shape).
# DATABASE_URL=host=/tmp port=5432 user=<you> dbname=laforge_dev sslmode=disable


# ============================================================
# GitHub App  (how LaForge connects to your content repos)
# ============================================================
# Full walkthrough for creating the App and finding these values is in
# USAGE.md -> "Connecting GitHub".

# Required -- the webhook secret you set when registering the App. This is
# the one value the API needs to start.
GITHUB_APP_WEBHOOK_SECRET=

# The App's OAuth credentials, for browser sign-in. Without them the app
# starts but no one can log in.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Optional, but set them together. They let the server mint its own
# per-repository access tokens instead of using GITHUB_SERVICE_TOKEN for
# every content fetch. Leave both empty to rely on GITHUB_SERVICE_TOKEN.
GITHUB_APP_ID=
# Path to the App's private key (.pem), e.g. .certs/your-app.private-key.pem
# -- a relative path there works both under docker compose and when running
# directly. Must be set together with GITHUB_APP_ID (both, or neither).
GITHUB_APP_PRIVATE_KEY_PATH=
# Cosmetic only -- used to build "Install on GitHub" links in the admin UI.
GITHUB_APP_SLUG=

# Optional fallback token (a personal access token with repo scope, or a
# service account's). Posts LaForge's commit-status checks back to GitHub,
# and stands in when a repo has no App installation behind it.
GITHUB_SERVICE_TOKEN=

# Comma-separated GitHub logins that get instance-wide admin -- required to
# approve an installed repository into LaForge (e.g. your-login,co-admin).
# Empty means no one can approve anything yet (a safe default, not a mistake).
LAFORGE_ADMIN_LOGINS=


# ============================================================
# Public addresses  (what BROWSERS reach)
# ============================================================
# The two origins an operator's browser talks to. In production these are
# your own HTTPS domains; there is no reason for them to be localhost once
# this is a real install.
#
#   UI_BASE_URL      the operator console. The browser lands here after login.
#   PUBLIC_BASE_URL  the HTTP API. It builds the GitHub OAuth callback, so it
#                    MUST exactly match the Callback URL on your GitHub App:
#                    <PUBLIC_BASE_URL>/auth/github/callback
#
# The layout below -- one domain, UI and API on sibling subdomains -- is the
# typical one. Because they share the domain example.com, login cookies work
# with nothing else to set.
UI_BASE_URL=https://laforge.example.com
PUBLIC_BASE_URL=https://api.laforge.example.com
#
# Other layouts:
#   * One origin behind a single reverse proxy: set BOTH to the same URL,
#     e.g. https://laforge.example.com for each.
#   * Local docker compose trial: clear both (they then default to
#     http://localhost:8081 and http://localhost:8080).

# Set to "true" ONLY when the UI and API are on unrelated domains that both
# serve HTTPS -- e.g. UI on laforge.example.com, API on laforge-api.example.net.
# Then login cookies switch to SameSite=None;Secure so the browser will send
# them cross-site. A subdomain split of one domain, or a single shared origin,
# does NOT need this -- leave it empty.
LAFORGE_CROSS_DOMAIN_COOKIES=


# ============================================================
# Agent addresses  (what DEPLOYED HOSTS reach)
# ============================================================
# Only needed when you deploy to a real hoster and want the on-host agents
# to check in. Leave this whole section empty to deploy WITHOUT agents (the
# default, and what the fake builder uses for dry runs).
#
# These are the addresses a freshly-booted VM on your hoster connects back
# to -- so they must be routable FROM the hoster's network, which is not
# necessarily how a browser reaches you.
#
#   GATEWAY_PUBLIC_ADDR  host:port of the agent gateway (mTLS, a raw TCP
#                        endpoint -- NOT an http:// URL). The host here is
#                        what you give scripts/gen-certs.sh so the gateway
#                        certificate matches it (see USAGE.md).
#   API_PUBLIC_URL       the API, as reached by deployed hosts (they fetch
#                        their agent binary from it). This is the SAME API as
#                        PUBLIC_BASE_URL above -- if your hosts reach the API
#                        at the same address browsers do, set it to the same
#                        value. It exists as its own var only for the case
#                        where hosts reach the API by a different path.
#
# Example for the example.com deployment above:
#   GATEWAY_PUBLIC_ADDR=gateway.example.com:8444
#   API_PUBLIC_URL=https://api.laforge.example.com
GATEWAY_PUBLIC_ADDR=
API_PUBLIC_URL=


# ============================================================
# Content source
# ============================================================
# A git checkout LaForge loads content from. Note the whole process shares
# this single path today, so one running instance serves one content
# checkout. The default (the current directory) is fine for compose.
REPO_ROOT=.


# ============================================================
# Gateway mTLS certificates
# ============================================================
# Required. Generate the CA and the gateway's server certificate with
# scripts/gen-certs.sh, which asks for the gateway address to issue the
# cert for (the host in GATEWAY_PUBLIC_ADDR; "localhost" for a local run).
# These files are gitignored; never commit them. Full details, including
# why ca.key is a real secret in production, are in USAGE.md -> Certificates.
GATEWAY_CA_CERT=.certs/ca.crt
GATEWAY_SERVER_CERT=.certs/server.crt
GATEWAY_SERVER_KEY=.certs/server.key


# ============================================================
# Container log forwarding (optional)
# ============================================================
# Each container's agent captures its application's console output (stdout and
# stderr) and streams it to the gateway over the same mTLS connection it already
# uses. When LOG_SINK_URL is set, the gateway enriches every line with its
# build/team/object identity and POSTs batches as newline-delimited JSON
# (application/x-ndjson) to this endpoint. Leave it unset to disable forwarding
# (agents still capture to the container console; the gateway just discards).
#
# The format is deliberately generic -- any collector that accepts newline JSON.
# For a backend that speaks its own wire format (Splunk HEC, Loki's push API,
# Elastic's bulk format), point this at a Vector / Fluent Bit / Promtail
# receiver and let it reshape and route. Example record:
#   {"ts":"2026-09-30T18:04:11.000Z","build_id":"...","team":3,
#    "object":"scoreboard","object_id":"...","kind":"container",
#    "stream":"stdout","line":"..."}
# LOG_SINK_URL=http://vector:9000/laforge-logs
#
# Optional request headers (comma-separated "Name: value" pairs) -- e.g. an auth
# token for Splunk HEC or an API key.
# LOG_SINK_HEADERS=Authorization: Splunk 00000000-0000-0000-0000-000000000000
#
# Optional static labels (comma-separated "key=value") added to every record,
# handy for tagging the event or environment.
# LOG_SINK_LABELS=env=cptc2026,source=laforge
