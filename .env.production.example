ACME_EMAIL=infra@example.com
LAFORGE_DOMAIN=laforge.cp.tc
GRPC_DOMAIN=grpc.laforge.cp.tc
GITHUB_CLIENT_ID=

# Host Caddy publishes 80/443/50051. Compose only binds these on loopback.
UI_PUBLISH=127.0.0.1:8080
GRPC_PUBLISH=127.0.0.1:15051
UI_UPSTREAM=127.0.0.1:8080
GRPC_UPSTREAM=127.0.0.1:15051

LAFORGE_CONFIG=./conf.prod.json
LAFORGE_CONFIG_DIR=./configs
SECRETS_DIR=./secrets
NPMRC_PATH=./secrets/npmrc
UI_ENVIRONMENT_PATH=./secrets/environment.prod.ts
