ACME_EMAIL=infra@example.com
LAFORGE_DOMAIN=laforge.cp.tc
GRPC_DOMAIN=grpc.laforge.cp.tc
GITHUB_CLIENT_ID=

# Keep 50051 public on the Azure VM. Restricting GRPC_BIND_IP to the VM's
# private address is also valid when Azure NAT owns the public address.
GRPC_BIND_IP=0.0.0.0

LAFORGE_CONFIG=./conf.prod.json
LAFORGE_CONFIG_DIR=./configs
SECRETS_DIR=./secrets
NPMRC_PATH=./secrets/npmrc

BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=14
